# Copy this file to ".env" (same folder) and fill in the values you need.

SECRET_KEY=change-me-to-any-random-text

# ---------- Database ----------
# sqlite = works instantly, no setup.   mysql = needs a running MySQL server.
DB_TYPE=sqlite
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=smart_healthcare      # created automatically

# ---------- Generative AI (put ONE key; the matching provider is auto-detected) ----------
# LLM_PROVIDER=gemini                  # anthropic | gemini | openai  (optional)
# LLM_MODEL=                           # optional model override
# GEMINI_API_KEY=your_key_here         # free key: https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# ---------- Admin account (auto-created on first start). CHANGE the password before submitting/deploying ----------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@smartcare.com
ADMIN_PASSWORD=Admin@123
